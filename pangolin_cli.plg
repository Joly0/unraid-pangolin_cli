<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name       "pangolin_cli">
  <!ENTITY author     "Joly0">
  <!ENTITY version    "2026.08.15">
  <!ENTITY cliVersion "0.15.1">
  <!ENTITY gitURL     "https://github.com/&author;/unraid-&name;/raw/main">
  <!ENTITY pluginURL  "&gitURL;/&name;.plg">
  <!ENTITY md5        "7d4e6e94ad2c877f85711a508bacdc2f">
  <!ENTITY binURL     "https://github.com/fosrl/cli/releases/download/&cliVersion;/pangolin-cli_linux_amd64">
  <!ENTITY plugin     "/boot/config/plugins/&name;">
  <!ENTITY emhttp     "/usr/local/emhttp/plugins/&name;">
  <!ENTITY binPersist "&plugin;/pangolin">
  <!ENTITY binTarget  "/usr/local/bin/pangolin">
]>

<!-- launch: makes the icon on the Plugins page link to the settings page. The
     page name is resolved directly from the URL (template.php looks it up by
     basename and does NOT evaluate Cond), so this keeps working when the Newt
     plugin is installed too and this page is hidden from the menu in favour of
     the shared "Pangolin" tab.
     icon: a .png is looked up under plugins/<name>/, so this shows the actual
     Pangolin logo rather than a generic font glyph.
     support: when present here it takes precedence over the Community Apps
     template's <Support> entry. -->
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" min="7.0.0" launch="Settings/PangolinCLI" icon="pangolin_cli.png" support="https://forums.unraid.net/topic/199839-plugin-pangolin-cli/">

<CHANGES>

###2026.08.15
- Fixed the daily "Potentially dangerous mode on pangolin_cli: 0666" cron mail. The plugin's logrotate and cron entries were installed world-writable, so logrotate refused them and /var/log/pangolin_cli.log was never rotated. Upgrading also repairs the permissions of an existing install.

###2026.08.13a
- Plugins page: the plugin icon is now the Pangolin logo and links to its settings page.
- The support thread link is now part of the plugin itself, so it survives updates.

###2026.08.13
- Settings page now shares a single "Pangolin" entry with the Pangolin Newt plugin when both are installed, with a tab for each. Installed on its own, this plugin keeps its own entry as before.
- Log viewer: a line's own level marker now decides its colour, so routine "WARN: ... failed" reconnect messages are no longer highlighted as errors.
- The Connect/Disconnect/Apply buttons target their own form, so they keep working when both Pangolin plugins share the grouped Settings entry as tabs.
- Connecting no longer freezes the webGui: /update.php holds the PHP session lock for the whole request, so connecting now runs in the background and the page reports progress via its status line.

###2026.08.04
- Updated Pangolin CLI to 0.15.1. Changes from the Pangolin CLI:
  - Fix some websocket disconnections by adding deadlines to websocket
  - Fix local to relay flapping if there is an overlapping CIDR route with a site local address
  - Support -i in the native Pangolin ssh command

###2026.07.20
- Updated Pangolin CLI to 0.15.0.

###2026.07.16
- Updated Pangolin CLI to 0.14.0.

###2026.07.12
- Firewall rule now inserts directly above Tailscale's ts-input jump instead of forcing position 1 (no more rule churn; ip6tables covered too).
- Stop no longer matches unrelated processes; start verifies the connection and the settings page shows a three-state status (connected / starting / stopped).
- Log viewer: fewer false error highlights and memory-bounded log tailing.
- Packaging: same-day releases get letter-suffixed versions, hardened install scripts, and older packages on the flash drive are now kept.

###2026.07.09
- Fixed: the Connect/Apply buttons did nothing (silently) after a reboot because the webGui service wrapper was packaged without its execute bit. The package now ships it as 0755 and the installer re-asserts the mode on every boot.

###2026.07.08
- Updated Pangolin CLI to 0.13.0.

###2026.07.06
- Updated Pangolin CLI to 0.12.0.

###2026.06.30
- Updated Pangolin CLI to 0.11.0.

###2026.06.26
- Updated Pangolin CLI to 0.10.2.

###2026.06.14
- Initial release. Installs Pangolin CLI &cliVersion; and adds a Settings page to connect this server to a Pangolin instance as a machine client.

</CHANGES>

<!-- Download and install the webGui package (settings page + service script) -->
<FILE Name="&plugin;/&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>&gitURL;/packages/&name;-&version;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<!-- Install the Pangolin CLI binary.
     The root filesystem is volatile on Unraid, so the binary is kept on the
     flash drive and restored to PATH on every boot. It is downloaded once
     (or whenever the bundled CLI version changes). -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &plugin;
NEED_DOWNLOAD=1
if [ -s "&binPersist;" ] &amp;&amp; "&binPersist;" version 2>/dev/null | grep -qwF '&cliVersion;'; then
  NEED_DOWNLOAD=0
fi
if [ "$NEED_DOWNLOAD" = "1" ]; then
  echo "Downloading Pangolin CLI &cliVersion; ..."
  if curl -fsSL -o "&binPersist;.tmp" "&binURL;"; then
    mv -f "&binPersist;.tmp" "&binPersist;"
  else
    rm -f "&binPersist;.tmp"
    if [ ! -s "&binPersist;" ]; then
      echo "ERROR: failed to download the Pangolin CLI binary from &binURL;"
      echo "Check the server's internet connection and reinstall the plugin."
      exit 1
    fi
    echo "WARNING: download failed, keeping the previously installed binary."
  fi
fi
install -D -m 0755 "&binPersist;" "&binTarget;"
echo "Pangolin CLI installed: $("&binTarget;" version 2>/dev/null | head -n1)"
</INLINE>
</FILE>

<!-- Start the client on boot if the user enabled autostart -->
<FILE Run="/bin/bash">
<INLINE>
# The webGui wrapper must be executable for /update.php to run it; assert it
# on every (re)install as a safety net in case a package lost the exec bit.
chmod 755 &emhttp;/scripts/rc.pangolin 2>/dev/null
# logrotate and crond both refuse a config file that is group- or
# other-writable. Packages up to 2026.08.13a shipped these as 0666, so fix the
# installed copies directly rather than relying on the package modes alone.
chmod 644 /etc/logrotate.d/&name; /etc/cron.d/&name; 2>/dev/null
if [ -x /etc/rc.d/rc.pangolin ]; then
  /etc/rc.d/rc.pangolin autostart 2>/dev/null
fi
</INLINE>
</FILE>

<!-- Installation complete message -->
<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "----------------------------------------------------------------"
echo " Pangolin CLI plugin installed."
echo " Configure your connection under Settings > Pangolin CLI."
echo "----------------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "----------------------------------------"
echo "------- Uninstalling Pangolin CLI -------"
echo "----------------------------------------"
/etc/rc.d/rc.pangolin stop 2>/dev/null
removepkg &name;-&version; 2>/dev/null
rm -f &binTarget;
rm -rf &emhttp;
rm -rf &plugin;
echo "Pangolin CLI plugin removed."
</INLINE>
</FILE>

</PLUGIN>
